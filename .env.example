# ---------- Photon Spectrum (iMessage) ----------
# From your Photon dashboard (https://photon.codes). Required for `npm run dev`.
PROJECT_ID=
PROJECT_SECRET=

# Optional: self-hosted iMessage line on a teammate's Mac (`npm run local`).
# Only needed if the shared Pro-plan number can't join group chats.
IMESSAGE_LOCAL_ADDRESS=
IMESSAGE_LOCAL_TOKEN=
IMESSAGE_LOCAL_PHONE=

# ---------- AI model (pick ONE) ----------
# Option A: Azure OpenAI (qualifies for "Best Use of Azure by Avanade")
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Option B: any OpenAI-compatible endpoint (plain OpenAI if OPENAI_BASE_URL is empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
#   GitHub Models (free, runs on Azure): OPENAI_BASE_URL=https://models.github.ai/inference
#     OPENAI_API_KEY=<GitHub token with "models: read">  OPENAI_MODEL=openai/gpt-4o-mini
#   Azure AI Foundry model (e.g. Phi-4-mini): OPENAI_BASE_URL=<the model's OpenAI-compatible endpoint>
#     OPENAI_API_KEY=<its key>  OPENAI_MODEL=<deployment name>

# With neither set, Keeper uses a built-in rule-based "mock brain" (free, offline, dumber).

# ---------- ElevenLabs (voice recaps + meeting transcription) ----------
ELEVENLABS_API_KEY=
# Any voice id from https://elevenlabs.io/app/voice-library (default: "Rachel")
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# ---------- Behaviour knobs ----------
# Seconds to wait for people to finish typing before thinking (one model call per burst)
BURST_SECONDS=6
# Only act on things the model is at least this sure about
MIN_CONFIDENCE=0.75
# Max unprompted messages per chat per day, and minimum gap between them
UNPROMPTED_DAILY_MAX=6
UNPROMPTED_COOLDOWN_MIN=20
# Resurface an unclaimed idea / open item after this many minutes
# (set both of these to 1 for the live demo)
RESURFACE_AFTER_MIN=120

# ---------- Tiger Data (growth history, optional) ----------
# Connection string from your Tiger Cloud service (https://console.cloud.timescale.com). Postgres works too.
TIGER_DATABASE_URL=

# ---------- Tree page / API ----------
# Where people open their tree: your GoDaddy Registry domain (used in "keeper code" replies)
PUBLIC_URL=http://127.0.0.1:8787
# Optional: require this token to upload meetings from the website
INGEST_TOKEN=
API_PORT=8787
# Set to 0.0.0.0 to expose to a tunnel/deploy (default only localhost)
API_HOST=127.0.0.1
# Comma-separated origins allowed to fetch the API (e.g. your DeepSpace or GoDaddy domain). * = any.
CORS_ORIGINS=*
DATA_FILE=data/state.json
